# Application
APP_NAME=Copilote IA QA
APP_ENV=production
APP_VERSION=0.4.1
LOG_LEVEL=INFO

# Ports exposes par Docker Compose
API_PORT=8000
DASHBOARD_PORT=8501

# SQLite P0: chemin absolu dans le volume persistant du conteneur API
DATABASE_URL=sqlite+pysqlite:////data/copilote_qa.db
SQLITE_VOLUME_NAME=copilote_qa_sqlite_data

# Configuration interne des conteneurs
POLICY_PATH=/app/policies/qa-rules-v1.0.json
DASHBOARD_API_URL=http://api:8000

# Conserver 1 worker avec SQLite
UVICORN_WORKERS=1

# Aucun secret n'est requis pour le profil SQLite P0.
# Pour un backend externe futur, injecter les identifiants via l'environnement
# ou un gestionnaire de secrets; ne jamais les committer dans ce fichier.
